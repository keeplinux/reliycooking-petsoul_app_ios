{
  "name": "pet-smart-app",
  "private": true,
  "version": "1.3.18",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "sync": "npm run build && npx cap sync",
    "sync:ios": "npm run build && npx cap sync ios",
    "sync:android": "npm run build && npx cap sync android",
    "open:ios": "npx cap open ios",
    "open:android": "npx cap open android",
    "verify:parity": "node scripts/verify-parity.mjs",
    "build:ios": "npm run sync:ios && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Debug -sdk iphonesimulator -derivedDataPath .build/ios CODE_SIGNING_ALLOWED=NO build",
    "test:web": "playwright test",
    "verify:baseline": "node scripts/verify-baseline.mjs",
    "test:ios": "sh scripts/test-ios.sh",
    "release:ios": "sh scripts/release-ios.sh",
    "install:ios": "sh scripts/install-ios.sh"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "8.3.0",
    "@capacitor/android": "^8.3.3",
    "@capacitor/barcode-scanner": "3.1.3",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/cli": "^8.3.3",
    "@capacitor/core": "^8.3.3",
    "@capacitor/ios": "8.3.3",
    "@capacitor/keyboard": "8.0.6",
    "@tailwindcss/vite": "^4.3.2",
    "@types/three": "^0.186.0",
    "jsqr": "1.4.0",
    "lucide-react": "^1.14.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "tailwindcss": "^4.3.2",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "qrcode": "1.5.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10"
  }
}
